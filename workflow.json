    {
      "parameters": {
        "modelName": "google/gemma-4-e2b",
        "message": "=КРИТИЧЕСКОЕ ПРАВИЛО ПО МАССИВУ items:\nВ массив \"items\" попадают ТОЛЬКО физические детали. \n\nВсе вопросы должны попадать ТОЛЬКО в отдельный массив \"clarification_questions\". Вопросы должны быть на русском языке.\n\nЗапросы:\n{{ $json.response }}",
        "jsonSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"subject\": { \"type\": \"string\" },\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"part_name\": { \"type\": [\"string\", \"null\"] },\n          \"width_mm\": { \"type\": [\"number\", \"null\"] },\n          \"height_mm\": { \"type\": [\"number\", \"null\"] },\n          \"length_mm\": { \"type\": [\"number\", \"null\"] },\n          \"quantity\": { \"type\": [\"integer\", \"null\"] },\n          \"material\": { \"type\": [\"string\", \"null\"] },\n          \"comment\": { \"type\": [\"string\", \"null\"] }\n        },\n        \"required\": [\"part_name\", \"width_mm\", \"height_mm\", \"length_mm\", \"quantity\", \"material\", \"comment\"],\n        \"additionalProperties\": false\n      }\n    },\n    \"clarification_questions\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    }\n  },\n  \"required\": [\"subject\", \"items\", \"clarification_questions\"],\n  \"additionalProperties\": false\n}",
        "temperature": 0.1,
        "timeout": 1000
      },
