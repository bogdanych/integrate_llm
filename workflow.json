    {
      "parameters": {
        "modelName": "google/gemma-4-e2b",
        "message": "=Ты — эксперт отдела продаж компании по изготовлению клееного бруса.\nТвоя задача — проанализировать текст запроса клиента и выделить все параметры.\n\nВнимательно прочитай текст и определи:\npart_name - деталь, которая нужна клиенту, указывай её в именительном падеже\nwidth_mm, height_mm, length_mm — ширина, высота длина в миллиметрах. Если пользователь указал в других единицах измерения, переведи в миллиметры.\nQuantity — количество деталей (в штуках).\nmaterial — материал, из которого должна быть сделана деталь.\ncomment — Что нужно пользователю.\n\nЕсли что-то не указано явно, поставь в ячейке null.\nДеталей может быть несколько.\n\nТакже напиши «Вопросы». Там обозначь, чего не хватает и что ты не понял в запросе пользователя. \n\nЗапрос:\n{{ $json.clean_text }}",
        "jsonSchema": "{} ",
        "temperature": 1,
        "timeout": 1000
      },
      "type": "n8n-nodes-lmstudio.lmStudioSimpleMessage",
      "typeVersion": 1,
      "position": [
        416,
        -48
      ],
      "id": "a8e95d3e-941b-445c-b4ff-6bfc2d45afb9",
      "name": "LM Studio Simple Message",
      "credentials": {
        "lmStudioApi": {
          "id": "lllMVgR0SuwkY9HS",
          "name": "LM Studio account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $json.response;\nconst items = data.items || [];\nconst questions = data.clarification_questions || [];\n\nconst rows = items.map(item => `\n  <tr>\n    <td>${item.part_name ?? '—'}</td>\n    <td>${item.width_mm ?? '?'}</td>\n    <td>${item.height_mm ?? '?'}</td>\n    <td>${item.length_mm ?? '?'}</td>\n    <td>${item.quantity ?? '?'}</td>\n    <td>${item.material ?? '—'}</td>\n    <td>${item.comment ?? '—'}</td>\n  </tr>\n`).join('');\n\nconst table = `\n<table border=\"1\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%; font-family: Arial, sans-serif; font-size: 14px;\">\n  <thead>\n    <tr style=\"background-color: #f2f2f2; text-align: left;\">\n      <th>Название детали</th>\n      <th>Требуемая ширина (мм)</th>\n      <th>Требуемая высота (мм)</th>\n      <th>Требуемая длина (мм)</th>\n      <th>Количество (шт)</th>\n      <th>Материал</th>\n      <th>Комментарий</th>\n    </tr>\n  </thead>\n  <tbody>\n    ${rows}\n  </tbody>\n</table>\n`;\n\nconst questionsBlock = questions.length > 0 \n  ? `<h3 style=\"font-family: Arial, sans-serif;\">Вопросы для уточнения:</h3><ul style=\"font-family: Arial, sans-serif;\">${questions.map(q => `<li>${q}</li>`).join('')}</ul>`\n  : '<p style=\"font-family: Arial, sans-serif;\">Уточнений не требуется.</p>';\n\nreturn [{\n  json: {\n    html_email: table + questionsBlock,\n    email_subject: data.subject || 'Ответ на ваш запрос' \n  }\n}];"
      },
